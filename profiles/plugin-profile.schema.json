{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eoingti.com/schemas/nalapps-plugin-profile.schema.json",
  "title": "NalApps WordPress Plugin Profile",
  "type": "object",
  "required": ["plugin_name", "slug", "product_type", "frontend", "database", "cron", "rest_api", "external_api", "file_upload", "multisite"],
  "properties": {
    "plugin_name": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "description": {"type": "string"},
    "plugin_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "requires_wp": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
    "requires_php": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
    "product_type": {"enum": ["free", "edd_paid", "private"]},
    "license_required": {"type": "boolean"},
    "frontend": {"type": "boolean"},
    "database": {"type": "boolean"},
    "cron": {"type": "boolean"},
    "rest_api": {"type": "boolean"},
    "external_api": {"type": "boolean"},
    "file_upload": {"type": "boolean"},
    "multisite": {"type": "boolean"},
    "telemetry": {"enum": ["off", "opt_in"]},
    "release_mode": {"enum": ["manual", "auto_on_version_bump"]},
    "uninstall_policy": {"enum": ["preserve", "delete_all"], "default": "preserve"},
    "data_contract": {
      "type": "object",
      "properties": {
        "options": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
          "uniqueItems": true
        },
        "site_options": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
          "uniqueItems": true
        },
        "post_types": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9_-]+$", "maxLength": 20},
          "uniqueItems": true
        },
        "custom_tables": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "edd_download_id": {"type": ["integer", "null"], "minimum": 1},
    "edd_store_url": {"type": ["string", "null"], "format": "uri"},
    "plugin_uri": {"type": ["string", "null"], "format": "uri"},
    "support_uri": {"type": ["string", "null"], "format": "uri"},
    "update_uri": {"type": ["string", "null"], "format": "uri"},
    "license": {"type": "string"},
    "license_uri": {"type": ["string", "null"], "format": "uri"},
    "requires_plugins": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"required": ["product_type"], "properties": {"product_type": {"const": "edd_paid"}}},
      "then": {"required": ["edd_download_id", "edd_store_url"]}
    },
    {
      "if": {"required": ["product_type"], "properties": {"product_type": {"const": "free"}}},
      "then": {
        "required": ["license_required"],
        "properties": {"license_required": {"const": false}}
      }
    }
  ],
  "additionalProperties": false
}
