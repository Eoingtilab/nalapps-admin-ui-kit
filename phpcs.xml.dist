<?xml version="1.0"?>
<ruleset name="NalApps WordPress Plugin Standard">
  <description>WordPress coding standards gate for generated NalApps plugin code.</description>
  <file>build/self-test</file>
  <arg name="extensions" value="php" />
  <arg value="ps" />
  <rule ref="WordPress-Core">
    <exclude name="WordPress.WP.I18n" />
  </rule>
  <rule ref="WordPress-Extra">
    <exclude name="WordPress.WP.I18n" />
  </rule>
  <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
